# Viewpoint FPS Optimization - example configuration
# Copy to:  <user>\Zomboid\vpfps.properties
# The file hot-reloads within ~5 s while the game runs - edit it live.
# PREFER THE IN-GAME PANEL: press F8 (governor, frame cap, RAM/VRAM, overlay).

# master kill switch - false = every Viewpoint setting we touched is
# restored to stock and all hooks pass through
enabled=true

# governor mode: adaptive | fixed | off
governor=adaptive

# frame-time budget the governor tries to hold (15..480)
targetFps=60

# quality ladders: scale Viewpoint's own settings inside their ranges.
# factor 1.0 = stock, lower = leaner. The CPU ladder covers chunk
# builds / walks / far jobs / bake budgets; the GPU ladder covers draw
# distance / far detail / corpse models.
cpuAdaptive=true
gpuAdaptive=true
cpuFactorMin=0.30
gpuFactorMin=0.30

# values used in "fixed" mode (0.10..1.0)
cpuFactorFixed=1.0
gpuFactorFixed=1.0

# RAM / VRAM pool budget scale (0.30..2.0, 1.0 = stock)
memoryScale=1.0

# on-screen performance overlay (F9 toggles it in game)
overlay=true
overlayDetail=true

# append a benchmark row to Zomboid/vpfps-stats.csv every 5 seconds
statsExport=false

# PZ_Optimization defer policy: auto | on | off
#   auto/on - when PZ_Optimization is detected, our overlay steps aside
#             (it has its own F9 overlay); everything else stays active.
#   off     - never defer
deferToPZOpt=auto

# first-run hardware heuristic (only applies when no config file exists)
autoProfile=true

# verbose logging to Zomboid/Logs/vpfps.log
debug=false
